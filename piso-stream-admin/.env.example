# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public URL where the admin panel is served.
APP_URL="https://www.pisostream.online/portal"

# Base path used by the built admin bundle.
VITE_APP_BASE_PATH="/portal/"

# Optional API override. Leave blank when the admin is served by kiosk-server
# on the same domain and port.
VITE_API_BASE_URL=""
